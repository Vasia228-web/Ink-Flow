# nullable-анотації (?) використовуються по всьому проєкту, тож контекст маємо вмикати
# в кожній збірці — інакше кожна анотація дає CS8632.
# CS8618 вимкнено свідомо: поля [SerializeField] заповнює десеріалізація Unity,
# а не конструктор, тож "non-nullable field must contain a non-null value" тут структурно хибне.
-nullable:enable
-nowarn:8618
